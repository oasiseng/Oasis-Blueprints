{
 "schema": "oasis-blueprints/taxonomy/0.1",
 "_about": [
  "How sets are sorted into project types and variants. Edit this file, then run `build` again (no need to `scan` again).",
  "Patterns are regular expressions, case-insensitive. `path` is tested against the set's path below the root, file name included.",
  "`title` is tested against the big title on the cover. `sheets` is tested against each sheet name.",
  "A path match scores 100, a title match 50, sheet-name matches 10 each (up to 30). The best score wins; on a tie the type listed first wins.",
  "`when` limits a type or variant to sets with certain attributes: stories_min, stories_max, or an attribute name with a value or a list of values.",
  "A variant with no `match` takes whatever the variants above it did not. Types marked origin `yours` come from the engineer's own list; `catalog` ones were added from a plan catalog. Site-specific ignores go in _state/local.json."
 ],
 "tiers": {
  "core": 60,
  "common": 25
 },
 "ignore": [
  "(^|/)_",
  "(^|/)RENDERINGS?(/|$)"
 ],
 "attributes": {
  "_about": "Read from names only (path, cover title, sheet names, view and detail titles), never from note text. Rules are listed strongest first.",
  "walls": [
   {
    "value": "cmu",
    "any": [
     "(?<![a-z])cmu(?![a-z])",
     "masonry wall",
     "block wall",
     "concrete block"
    ]
   },
   {
    "value": "wood",
    "any": [
     "stud",
     "wall[ _-]*wood",
     "wood[ _-]*wall",
     "wall framing",
     "wood fram"
    ]
   }
  ],
  "stories": [
   {
    "value": 4,
    "any": [
     "fourth floor",
     "4th floor"
    ]
   },
   {
    "value": 3,
    "any": [
     "third floor",
     "3rd floor"
    ]
   },
   {
    "value": 2,
    "any": [
     "second floor",
     "2nd floor",
     "upper floor",
     "upper level",
     "(?<![a-z])loft(?![a-z])"
    ]
   },
   {
    "value": 1,
    "any": [
     "floor plan"
    ]
   }
  ],
  "flood": [
   {
    "value": true,
    "any": [
     "flood",
     "(?<![a-z])bfe(?![a-z])",
     "breakaway",
     "v[- ]zone",
     "piling",
     "pile foundation"
    ]
   }
  ],
  "roof": [
   {
    "value": "gambrel",
    "any": [
     "gambrel"
    ]
   },
   {
    "value": "monoslope",
    "any": [
     "mono[ -]?slope",
     "lean[- ]to",
     "shed roof"
    ]
   },
   {
    "value": "gable",
    "any": [
     "gable"
    ]
   },
   {
    "value": "hip",
    "any": [
     "(?<![a-z])hip(?![a-z])"
    ]
   },
   {
    "value": "flat",
    "any": [
     "flat roof"
    ]
   }
  ],
  "foundation": [
   {
    "value": "piles",
    "any": [
     "piling",
     "(?<![a-z])piles?(?![a-z])"
    ]
   },
   {
    "value": "crawl space",
    "any": [
     "crawl"
    ]
   },
   {
    "value": "slab",
    "any": [
     "slab"
    ]
   },
   {
    "value": "piers or footings",
    "any": [
     "pier",
     "footing",
     "deck block"
    ]
   }
  ],
  "style": [
   {
    "value": "farmhouse",
    "any": [
     "farmhouse",
     "homestead"
    ]
   },
   {
    "value": "barndominium",
    "any": [
     "barndominium"
    ]
   },
   {
    "value": "a-frame",
    "any": [
     "a[- ]frame"
    ]
   },
   {
    "value": "bungalow or cottage",
    "any": [
     "bungalow",
     "cottage"
    ]
   }
  ]
 },
 "types": [
  {
   "key": "garage-conversion",
   "name": "Garage conversion",
   "origin": "yours",
   "match": {
    "path": [
     "garage conversion"
    ],
    "title": [
     "garage conversion"
    ]
   },
   "variants": [
    {
     "key": "cmu-walls",
     "name": "CMU walls",
     "match": {
      "path": [
       "wall[ _-]*cmu",
       "cmu[ _-]*wall"
      ]
     }
    },
    {
     "key": "wood-walls",
     "name": "Wood walls",
     "match": {
      "path": [
       "wall[ _-]*wood",
       "wood[ _-]*wall"
      ]
     }
    },
    {
     "key": "cmu-walls",
     "name": "CMU walls",
     "when": {
      "walls": [
       "cmu",
       "cmu+wood"
